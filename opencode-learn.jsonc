{
  "$schema": "https:\/\/opencode.ai\/config.json",
  "instructions": [
    "\/root\/.config\/termant\/learned.md"
  ],
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "phone *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "date *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "learn *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "team *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "safe *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tidy *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "study *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "readfile *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "me *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "watch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "diary *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "draw *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "apilayer *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm \/sdcard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* \/sdcard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm \/storage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* \/storage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* \/",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* ~",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* ~\/",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* \/root",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -* \/root\/",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd * of=\/dev\/*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
