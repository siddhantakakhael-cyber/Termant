#!/bin/bash
# Installs (once) and starts OpenCode, an open-source AI coding agent.
#   termant-agent [--install-only] [opencode arguments]
export PATH="$HOME/.opencode/bin:$PATH"

# Where OpenCode's installer comes from (the tests name another place).
installer=${TERMANT_OPENCODE_INSTALLER:-https://opencode.ai/v2/install}

# Reads what the installer prints and passes it on line by line; a bar with a percentage at
# its end becomes "Downloading the AI agent (OpenCode): 13%".
say_progress() {
  local piece percent last=
  while IFS= read -r -d $'\r' piece || [ -n "$piece" ]; do
    while [[ $piece == *$'\n'* ]]; do
      printf '%s\n' "${piece%%$'\n'*}"
      piece=${piece#*$'\n'}
    done
    if [[ $piece =~ ([0-9]{1,3})([.,][0-9])?\ ?%[[:space:]]*$ ]]; then
      percent=${BASH_REMATCH[1]}
      if [ "$percent" != "$last" ]; then
        last=$percent
        echo "Downloading the AI agent (OpenCode): $percent%"
      fi
    elif [ -n "${piece//[[:space:]]/}" ]; then
      printf '%s\n' "$piece"
    fi
  done
}

if ! command -v opencode >/dev/null 2>&1; then
  case "$(uname -m)" in
    aarch64|x86_64) ;;
    *) echo "OpenCode has no version for this phone's processor ($(uname -m))."; exit 1 ;;
  esac
  echo 'Setting up the AI agent (OpenCode). One-time download, about 120 MB.'
  missing=
  for tool in curl git tar python3; do command -v $tool >/dev/null 2>&1 || missing=1; done
  [ -e /etc/ssl/certs/ca-certificates.crt ] || missing=1
  if [ -n "$missing" ]; then
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      curl ca-certificates git tar python3 \
      || { echo 'Could not install the tools the agent needs. Check your internet connection.'; exit 1; }
  fi
  if [ -t 1 ]; then
    # in a terminal the installer draws its own bar
    curl -fsSL "$installer" | bash -s -- --no-modify-path
    installed=$?
  else
    # In the chat nothing can redraw a line: the installer's bar ("####   13.7%", drawn again
    # and again on one line) is said in words, one line for every percent.
    curl -fsSL "$installer" | bash -s -- --no-modify-path 2>&1 | say_progress
    installed=${PIPESTATUS[1]}
  fi
  [ "$installed" = 0 ] \
    || { echo 'OpenCode could not be installed. Check your internet connection and try again.'; exit 1; }
  command -v opencode >/dev/null 2>&1 || { echo 'OpenCode did not install correctly.'; exit 1; }
fi

# Tell the agent it lives on a phone and how to control it. The guide is
# replaced on app updates unless you delete its first line.
conf="$HOME/.config/opencode"
mkdir -p "$conf"
if [ ! -e "$conf/AGENTS.md" ] || head -n 1 "$conf/AGENTS.md" | grep -q termant-managed; then
  cp /usr/local/lib/termant/AGENTS.md "$conf/AGENTS.md"
fi
if [ ! -e "$conf/opencode.json" ] && [ ! -e "$conf/opencode.jsonc" ]; then
  cp /usr/local/lib/termant/opencode.jsonc "$conf/opencode.jsonc"
fi

# What the agent learned in earlier chats (notes, own tools) is read by
# OpenCode from one file; write it again from what is saved now.
learn refresh >/dev/null 2>&1
# The helper agents that come with Termant (see `team`): written again, so that app updates reach them.
team refresh >/dev/null 2>&1

if [ "$1" = --install-only ]; then exit 0; fi
# The agent reads and edits files in its folder, so give it one of its own.
if [ "$PWD" = "$HOME" ]; then mkdir -p "$HOME/workspace" && cd "$HOME/workspace"; fi
exec opencode "$@"
