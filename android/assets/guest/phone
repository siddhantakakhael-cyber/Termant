#!/bin/bash
# Control the Android phone from inside Ubuntu. Talks to the Termant app.
#   phone help
if ! read -r port token 2>/dev/null < /etc/termant/bridge; then
  echo "phone: the Termant app is not running" >&2
  exit 1
fi
[ $# -gt 0 ] || set -- help
# phone look FILE: the app cannot see Ubuntu's files, so the picture itself is sent along
picture=
if [ "$1" = look ] && [ $# -ge 2 ] && [ "$2" != last ]; then
  [ $# -eq 2 ] || { echo "usage: phone look [FILE | last]" >&2; exit 1; }
  picture=$2
  [ -f "$picture" ] && [ -r "$picture" ] || { echo "phone look: there is no such file: $picture" >&2; exit 1; }
  size=$(stat -c %s -- "$picture" 2>/dev/null) || size=0
  [ "$size" -gt 0 ] || { echo "phone look: the file is empty: $picture" >&2; exit 1; }
  [ "$size" -le 33554432 ] || { echo "phone look: the file is bigger than 32 MB: $picture" >&2; exit 1; }
fi
{ exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null || {
  echo "phone: cannot reach the Termant app (open the app and try again)" >&2
  exit 1
}
if [ -n "$picture" ]; then
  printf '%s\0' "$token" 4 look - "$(basename -- "$picture")" "$size" >&3
  cat -- "$picture" >&3
else
  printf '%s\0' "$token" "$#" "$@" >&3
fi
IFS= read -r status <&3
if [ "$status" = OK ]; then
  cat <&3
  exit 0
fi
cat <&3 >&2
exit 1
