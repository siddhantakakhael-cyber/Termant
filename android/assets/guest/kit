# ---------------------------------------------------------------- diary: what was done

def diary(args):
    path = os.path.join(DATA, "diary.jsonl")
    if args and args[0] == "add":
        entry = {"at": time.time(), "seconds": 0, "model": "", "ok": True, "helpers": 0, "text": ""}
        i = 1
        while i < len(args):
            a = args[i]
            if a == "--" and i + 1 < len(args):
                entry["text"] = one_line(" ".join(args[i + 1:]), 160)
                break
            if a in ("--seconds", "--helpers") and i + 1 < len(args):
                try:
                    entry[a[2:]] = int(float(args[i + 1]))
                except ValueError:
                    pass
                i += 1
            elif a == "--model" and i + 1 < len(args):
                entry["model"] = args[i + 1][:80]
                i += 1
            elif a == "--ok" and i + 1 < len(args):
                entry["ok"] = args[i + 1] in ("0", "yes", "true")
                i += 1
            elif a == "--turn" and i + 1 < len(args):
                entry["changes"] = len(turn_log(re.sub(r"[^A-Za-z0-9._-]", "", args[i + 1])))
                i += 1
            elif a == "--kind" and i + 1 < len(args):
                entry["kind"] = args[i + 1][:20]
                i += 1
            i += 1
        os.makedirs(DATA, exist_ok=True)
        lines = []
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()[-1999:]
        except OSError:
            pass
        lines.append(json.dumps(entry, ensure_ascii=False))
        with open(path + ".new", "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(path + ".new", path)
        return
    if args and not args[0].isdigit():
        out("""diary: what the agent did
  diary          today
  diary N        the last N days""")
        return
    days = max(1, min(60, int(args[0]))) if args else 1
    start = time.mktime(time.localtime()[:3] + (0, 0, 0, 0, 0, -1)) - (days - 1) * DAY
    entries = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    e = json.loads(line)
                    if e["at"] >= start:
                        entries.append(e)
                except (ValueError, KeyError):
                    pass
    except OSError:
        pass
    label = "today" if days == 1 else "the last %d days" % days
    if not entries:
        out("Nothing was done %s." % label)
        return
    seconds = sum(e.get("seconds", 0) for e in entries)
    out("Work diary, %s: %d job(s), %d min %02d s of work, %d did not work, %d helper(s) used, %d file change(s) that can be undone"
        % (label, len(entries), seconds // 60, seconds % 60, sum(1 for e in entries if not e.get("ok", True)),
           sum(e.get("helpers", 0) for e in entries), sum(e.get("changes", 0) for e in entries)))
    for e in entries[-60:]:
        marks = []
        if e.get("kind"):
            marks.append(e["kind"])
        if e.get("helpers"):
            marks.append("%d helper(s)" % e["helpers"])
        if e.get("changes"):
            marks.append("%d file change(s)" % e["changes"])
        if not e.get("ok", True):
            marks.append("did not work")
        out("%s  %4ds  %-28s %s%s" % (time.strftime("%m-%d %H:%M", time.localtime(e["at"])), e.get("seconds", 0),
                                      (e.get("model") or "automatic")[:28], e.get("text", ""),
                                      "  [" + ", ".join(marks) + "]" if marks else ""))


