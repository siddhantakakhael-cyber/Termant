{
  "$schema": "https://opencode.ai/config.json",
  // The agent may use the phone controls and the web without asking each time.
  "permissions": [
    { "action": "shell", "resource": "phone *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "learn *", "effect": "allow" },
    { "action": "shell", "resource": "team *", "effect": "allow" },
    { "action": "shell", "resource": "safe *", "effect": "allow" },
    { "action": "shell", "resource": "tidy *", "effect": "allow" },
    { "action": "shell", "resource": "study *", "effect": "allow" },
    { "action": "shell", "resource": "readfile *", "effect": "allow" },
    { "action": "shell", "resource": "me *", "effect": "allow" },
    { "action": "shell", "resource": "watch *", "effect": "allow" },
    { "action": "shell", "resource": "diary *", "effect": "allow" },
    { "action": "shell", "resource": "draw *", "effect": "allow" },
    { "action": "shell", "resource": "apilayer *", "effect": "allow" },
    // Never, whoever asks: wiping the phone's storage or the system (delete files with `safe rm`).
    { "action": "shell", "resource": "rm /sdcard*", "effect": "deny" },
    { "action": "shell", "resource": "rm -* /sdcard*", "effect": "deny" },
    { "action": "shell", "resource": "rm /storage*", "effect": "deny" },
    { "action": "shell", "resource": "rm -* /storage*", "effect": "deny" },
    { "action": "shell", "resource": "rm -* /", "effect": "deny" },
    { "action": "shell", "resource": "rm -* ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -* ~/", "effect": "deny" },
    { "action": "shell", "resource": "rm -* /root", "effect": "deny" },
    { "action": "shell", "resource": "rm -* /root/", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd * of=/dev/*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" }
  ],
  // What the agent learned in earlier chats: its notes and the tools it made (see `learn help`).
  "instructions": ["/root/.config/termant/learned.md"],
  // Web search needs no key with Exa. Termant's Settings can turn it off.
  "websearch": { "provider": "exa" }
  // Termant writes this file again before each chat message, from its
  // Settings: MCP servers added there appear here as, for example,
  // "mcp": {
  //   "servers": {
  //     "filesystem": { "type": "local", "command": ["/bin/bash", "-lc", "npx -y @modelcontextprotocol/server-filesystem /sdcard"] }
  //   }
  // }
}
