{
  "$schema": "https://opencode.ai/config.json",
  // The agent may use the phone controls without asking each time.
  // Everything else still asks first.
  "permissions": [
    { "action": "shell", "resource": "phone *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" }
  ],
  // MCP servers the agent can connect to and use as tools.
  // Add your own in Termant's Settings → MCP servers, for example:
  // "mcpServers": {
  //   "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/sdcard"] }
  // }
}
