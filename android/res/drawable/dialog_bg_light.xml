<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog's window: a card with round corners, kept away from the screen's edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetTop="16dp" android:insetRight="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="@color/dialog_light" />
    </shape>
</inset>
